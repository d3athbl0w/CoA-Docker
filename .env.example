# ==============================================================================
# AzerothCore Conquest of Azeroth (CoA) Docker Repack Configuration
# ==============================================================================
# Copy this file to .env and adjust variables to match your environment.
# Example: cp .env.example .env
# ==============================================================================

# Compose Project Name (prefixes container and volume names)
COMPOSE_PROJECT_NAME=coa-repack

# Image Tag for Built Docker Images
DOCKER_IMAGE_TAG=latest

# ------------------------------------------------------------------------------
# Database Settings (MySQL 8.4 LTS)
# ------------------------------------------------------------------------------
# Root password for the MySQL database container
DOCKER_DB_ROOT_PASSWORD=password

# External port on host to access MySQL (HeidiSQL / Navicat / DBeaver)
DOCKER_DB_EXTERNAL_PORT=3306

# Database Names (Standard AzerothCore schema names)
AC_AUTH_DATABASE=acore_auth
AC_CHARACTERS_DATABASE=acore_characters
AC_WORLD_DATABASE=acore_world

# ------------------------------------------------------------------------------
# Network & Server Port Mappings (Host -> Container)
# ------------------------------------------------------------------------------
# Realmlist / Auth Server Port (3724 TCP is standard for WoW 3.3.5a)
DOCKER_AUTH_EXTERNAL_PORT=3724

# World Server Realm Port (8085 TCP is standard for WoW 3.3.5a)
DOCKER_WORLD_EXTERNAL_PORT=8085

# Remote SOAP Administration Port (Optional / Private)
DOCKER_SOAP_EXTERNAL_PORT=7878

# ------------------------------------------------------------------------------
# Container User & Permissions
# ------------------------------------------------------------------------------
# Non-root UID and GID inside the container (default: 1000 for standard Linux/WSL2 user)
DOCKER_USER_ID=1000
DOCKER_GROUP_ID=1000
DOCKER_USER=acore

# ------------------------------------------------------------------------------
# Volume & Host Mount Paths
# ------------------------------------------------------------------------------
# Persistent MySQL data volume name or host path
DOCKER_VOL_DB=ac-database-data

# Client game data (maps, vmaps, mmaps, dbc). Defaults to local ./data folder.
DOCKER_VOL_DATA=./data

# Server configuration overrides (maps to /azerothcore/env/dist/etc inside container)
DOCKER_VOL_ETC=./env/etc

# Server log files (maps to /azerothcore/env/dist/logs inside container)
DOCKER_VOL_LOGS=./env/logs
